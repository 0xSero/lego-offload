;; room.sb -- deny-by-default Room for a coding agent. Parameters (sandbox-exec -D): WS, HOME_DIR,
;; AGENT_DIR, LIB_DIR (realpaths: the sandbox matches resolved paths), ROUTE_PORT, DOOR_PORT. See room.py.

(version 1)
(deny default)

;; ---------------------------------------------------------------- process
(allow process-fork)
(allow process-exec
       (subpath (param "AGENT_DIR"))
       (subpath "/bin")
       (subpath "/usr/bin")
       (literal "/usr/libexec/path_helper"))
;; deputies, denied by name (defence in depth: the layers below block them too)
(deny process-exec
      (literal "/usr/bin/osascript")
      (literal "/usr/bin/open")
      (literal "/bin/launchctl")
      (literal "/usr/bin/launchctl")
      (literal "/usr/bin/mdfind")
      (literal "/usr/bin/mdls")
      (literal "/usr/bin/mdutil")
      (literal "/usr/bin/security")
      (literal "/usr/bin/ssh")
      (literal "/usr/bin/scp")
      (literal "/usr/bin/sftp")
      (literal "/usr/bin/pbcopy")
      (literal "/usr/bin/pbpaste")
      (literal "/usr/bin/shortcuts")
      (literal "/usr/bin/automator")
      (literal "/usr/bin/tccutil")
      (literal "/usr/bin/sudo")
      (literal "/usr/bin/login")
      (literal "/usr/bin/su"))
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)

;; ---------------------------------------------------------------- files: read-only system
(allow file-read* file-map-executable
       (subpath "/System/Library")
       (subpath "/System/Cryptexes")
       (subpath "/System/Volumes/Preboot/Cryptexes")
       (subpath "/usr/lib")
       (subpath "/usr/libexec")
       (subpath "/usr/share")
       (subpath "/bin")
       (subpath "/usr/bin")
       (subpath "/private/var/db/timezone")
       (subpath "/private/var/select")
       (subpath (param "AGENT_DIR"))
       (subpath (param "LIB_DIR")))

(allow file-read*
       (literal "/")
       (subpath "/private/etc")
       (literal "/dev/null")
       (literal "/dev/zero")
       (literal "/dev/random")
       (literal "/dev/urandom")
       (literal "/dev/dtracehelper")
       (literal "/dev/tty")
       (regex #"^/dev/ttys[0-9]+$")
       (subpath "/dev/fd"))

;; stat() of the path components leading to allowed roots (realpath walks),
;; plus the standard root symlinks. Metadata only: no listing, no content.
(allow file-read-metadata
       (literal "/etc") (literal "/tmp") (literal "/var")
       (path-ancestors (param "WS"))
       (path-ancestors (param "HOME_DIR"))
       (path-ancestors (param "AGENT_DIR"))
       (path-ancestors (param "LIB_DIR")))

;; ---------------------------------------------------------------- files: read/write
(allow file-read* file-write*
       (subpath (param "WS"))
       (subpath (param "HOME_DIR")))

(allow file-write-data file-ioctl
       (literal "/dev/null")
       (literal "/dev/zero")
       (literal "/dev/tty")
       (literal "/dev/dtracehelper")
       (regex #"^/dev/ttys[0-9]+$")
       (subpath "/dev/fd"))

;; ---------------------------------------------------------------- network
;; Only the Route and the Door, on loopback. No DNS, no LAN, no internet.
(allow network-outbound
       (remote tcp (string-append "localhost:" (param "ROUTE_PORT")))
       (remote tcp (string-append "localhost:" (param "DOOR_PORT"))))

;; ---------------------------------------------------------------- IPC
(allow ipc-posix-shm-read*
       (ipc-posix-name "apple.shm.notification_center"))
(allow mach-lookup
       (global-name "com.apple.system.notification_center")
       (global-name "com.apple.system.logger")
       (global-name "com.apple.logd"))

;; Codex asks cfprefsd for its own (possibly MDM-managed) settings at start. Only that
;; domain is readable; cfprefsd checks every other domain against this profile.
(allow mach-lookup
       (global-name "com.apple.cfprefsd.daemon")
       (global-name "com.apple.cfprefsd.agent"))
(allow user-preference-read
       (preference-domain "com.openai.codex"))
(allow ipc-posix-shm-read-data
       (ipc-posix-name-regex #"^apple\.cfprefs\.[0-9a-z]+v1$"))
