#!/usr/bin/env bash
# One command for everything: ./run            (or ./run integration|verify|sim|vm|e2e)
# integration  the real door, scrubber and node reader on real files with a stub model: the exchange
#              rule both ways, every leak the hunts found, the queue
# verify       Lean: the leak bound proved for any policy, any number of calls, any adaptive
#              strategy (timing, queue, cache included), then the Lean model run against the door
# sim          Bend Monte Carlo of a working day (budget x reply time), checked bit-exact
# vm           every connection of a session from inside the agent VM, what it cannot reach, and
#              no Mac credential in what the agents are given
# e2e          real agents in VMs and real models, every policy level both ways, canaries scanned
set -euo pipefail
cd "$(dirname "$0")"
R=verify/runs
mkdir -p "$R" results
t() { perl -e "alarm $1; exec @ARGV or die qq(cannot run \$ARGV[0]\n)" "${@:2}"; }   # hard timeout on every step
step() { printf '\n== %s\n' "$*"; }

integration() { step integration; t 600 python3 tests/integration.py; }

verify() {
  step "verify: Lean proofs for any number of nodes, scopes and steps, against any adaptive strategy"
  { cat verify/Lego.lean; for th in leak_bound sealed_hidden held_trusted budget reply_times $(sed -n \
      's/^theorem \(mutant_[a-z]*\).*/Mutants.\1/p' verify/Lego.lean); do echo "#print axioms Lego.$th"; done; } > $R/LegoAxioms.lean
  t 900 "$HOME/.elan/bin/lean" $R/LegoAxioms.lean | tee results/lean.txt
  if grep -q sorryAx results/lean.txt; then echo "LEAN: a proof is missing"; exit 1; fi
  echo "LEAN PROOFS CHECK ($(grep -c 'depends on axioms' results/lean.txt) theorems, no sorry)" | tee -a results/lean.txt
  step "verify: Lean model vs the real door on random call sequences"
  t 1800 python3 verify/twin.py 2000 0 | tee results/twin.txt
}

sim() {
  step "sim: 8192 sessions x 15 cells"
  t 900 bend run-c verify/sim.bend -s > $R/sim_raw.txt
  (cd verify && t 900 python3 sim_ref.py runs/sim_raw.txt ../results/sim.json)
}

vmcheck() { step "vm: connections from inside the agent VM"; t 1800 python3 tests/vmcheck.py; }
e2e() { step "e2e: every policy level, both ways, real models"; t 21600 python3 tests/e2e.py results/e2e.json; }

case "${1:-all}" in
  integration) integration ;; verify) verify ;; sim) sim ;; vm) vmcheck ;; e2e) e2e ;;
  all) integration; verify; vmcheck; e2e ;;
  *) echo "usage: ./run [all|integration|verify|sim|vm|e2e]"; exit 2 ;;
esac
